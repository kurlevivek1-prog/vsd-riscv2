How to Use (Software)
c#define TIMER_BASE   0x400040
#define TIMER_CTRL   (*((volatile uint32_t *)(TIMER_BASE + 0x00)))
#define TIMER_LOAD   (*((volatile uint32_t *)(TIMER_BASE + 0x04)))
#define TIMER_VALUE  (*((volatile uint32_t *)(TIMER_BASE + 0x08)))
#define TIMER_STATUS (*((volatile uint32_t *)(TIMER_BASE + 0x0C)))

// One-shot mode — count down from 100
TIMER_LOAD = 100;
TIMER_CTRL = 0x01;                   // EN=1, one-shot
while (!(TIMER_STATUS & 1));         // poll TIMEOUT
TIMER_STATUS = 1;                    // clear TIMEOUT
TIMER_CTRL = 0;                      // stop

// Periodic mode — toggle LED every 10 seconds
// 12MHz / 256 prescaler = 46875 ticks/sec
// 46875 x 10 = 468750
TIMER_LOAD = 468750;
TIMER_CTRL = (255 << 8) | (1<<2) | (1<<1) | (1<<0);  // PRESC_DIV=255, PRESC_EN, MODE, EN
while (1) {
    while (!(TIMER_STATUS & 1));     // wait for TIMEOUT
    TIMER_STATUS = 1;                // clear
    // toggle LED here
}

